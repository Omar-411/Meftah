PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
DB_DRIVER=memory
SEED_DEMO_DATA=true
JWT_TTL_SECONDS=43200
PUBLIC_SITE_URL=http://localhost:3000

# DB_DRIVER=mongo
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=darcrm

# Your own admin account: created at startup if it does not exist yet (works with demo data too).
# With SEED_DEMO_DATA=false it is also the only account on a fresh database.
# ADMIN_EMAIL=admin@votre-agence.tn
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrateur

# WhatsApp Cloud API (Meta). Without both, alerts are only logged.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
